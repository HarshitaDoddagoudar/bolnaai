# Smart Crisis Evaluator Configuration Example
# Copy this file to .env and insert your API keys (never commit .env to Git)

# LLM API for automated post-simulation transcript evaluation:
OPENAI_API_KEY=your_openai_api_key_here
# Optional alternative LLM providers:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Bolna API Key (optional: used to fetch transcripts directly by execution ID)
# BOLNA_API_KEY=bn-your_bolna_key_here
